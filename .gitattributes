# Sources are LF everywhere; tools/build-win.ps1 runs in bash inside Docker
# and breaks with CRLF.
*.cpp           text eol=lf
*.hpp           text eol=lf
*.h             text eol=lf
*.md            text eol=lf
*.in            text eol=lf
*.qrc           text eol=lf
*.ps1           text eol=lf
*.sh            text eol=lf
*.cmake         text eol=lf
CMakeLists.txt  text eol=lf
# Preserve upstream notice text and the exact bytes covered by its hashes.
resources/licenses/qt-3rdparty/*.txt text eol=lf whitespace=-blank-at-eol
